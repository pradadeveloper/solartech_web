{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3300",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3300/",
        "http://localhost:3300/cotizador/",
        "http://localhost:3300/servicios/epc/",
        "http://localhost:3300/blog/energia-solar-en-colombia/",
        "http://localhost:3300/energia-solar-en/medellin/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "blockedUrlPatterns": ["*googletagmanager*"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
