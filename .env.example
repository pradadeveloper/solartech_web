# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local al repo.

# Sitio
NEXT_PUBLIC_SITE_URL=https://solartechenergy.co
NEXT_PUBLIC_GTM_ID=GTM-WVZQJV4W

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: escribe leads y sube facturas. No usar prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (anti-spam del cotizador) — fase 4
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (emails transaccionales) — fase 4
RESEND_API_KEY=
LEADS_NOTIFY_TO=
LEADS_FROM_EMAIL=

# Integraciones de leads — fase 4
N8N_LEADS_WEBHOOK_URL=
# Endpoint dedicado de solartech_app para recibir leads del sitio, con clave compartida
SOLARTECH_APP_LEADS_URL=
SOLARTECH_APP_LEADS_KEY=

# Sal para el hash de IP (rate limit y auditoría sin guardar la IP en claro)
IP_HASH_SALT=

# Solo para pruebas E2E/CI: acepta leads sin Supabase ni Turnstile. NUNCA en producción.
# LEADS_DRY_RUN=1
